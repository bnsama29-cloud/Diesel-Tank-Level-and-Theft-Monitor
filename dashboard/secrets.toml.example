# Copy to .streamlit/secrets.toml (repository root) or paste into the
# Streamlit Community Cloud app's Secrets settings. Never commit the real file.
AIO_USERNAME = "your_adafruit_io_username"
AIO_KEY = "your_private_adafruit_io_key"
AIO_FEED_KEY = "tank-telemetry"          # optional, this is the default
AIO_ACK_FEED_KEY = "tank-manual-ack"     # optional, unused by the cloud firmware
